---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tallyUrl = "https://tally.so/r/EkMNAr";
const backupWechat = "addayan";

const magnetPacks: Record<string, { name: string; note: string; items: string[] }> = {
  "platform-rules-checklist": {
    name: "新手规则避坑清单",
    note: "规则",
    items: ["10 个常见违规场景", "发版前 7 项 checklist", "违规话术对照表"],
  },
  "keyword-cleaning-sheet": {
    name: "关键词清洗表",
    note: "清洗",
    items: ["8 字段关键词整理表", "关键词清洗 SOP", "按意图分组模板"],
  },
  "listing-checklist": {
    name: "Listing 自检清单",
    note: "自检",
    items: ["标题/五点检查项", "图片与转化要素", "上线前逐项核对表"],
  },
  "ppc-weekly-review": {
    name: "PPC 周复盘表",
    note: "报表",
    items: ["销量与广告数据复盘", "ACOS / 搜索词分析", "下周动作清单"],
  },
  "review-pain-analysis": {
    name: "Review 痛点分析表",
    note: "痛点",
    items: ["Review 痛点归类", "高频问题提炼", "Listing 改进点"],
  },
  "competitor-selection-matrix": {
    name: "竞品矩阵拆解表",
    note: "矩阵",
    items: ["4 维度竞品对比", "差异化机会判断", "选品决策辅助表"],
  },
  "ai-tools-review-sheet": {
    name: "AI 工具评测表",
    note: "AI评测",
    items: ["AI 工具 4 判断标准", "6 类适合场景", "选型对照表"],
  },
  default: {
    name: "AI 运营资料包",
    note: "AI运营资料包",
    items: ["AI 运营检查表", "Listing 优化 Prompt", "广告 PPC 复盘表", "Review 分析模板"],
  },
};

const magnetKey = Astro.url.searchParams.get("magnet") || "default";
const pack = magnetPacks[magnetKey] || magnetPacks.default;
---

<BaseLayout title={`领取 ${pack.name}｜阿岩跨境笔记`} description={`领取${pack.name}，包含亚马逊运营实操模板与检查表。填写表单或加微信备注「${pack.note}」即可获取对应资料。`}>
  <main class="lead-page">
    <section class="lead-card">
      <div class="lead-kicker">AI Amazon Resource Pack</div>
      <h1>领取 {pack.name}</h1>
      <p class="lead-desc">
        根据你的诊断结果，推荐领取「{pack.name}」。填写表单或直接加微信，我会按备注发送对应资料。
      </p>

      <div class="lead-survey-hint">
        <p>不确定领哪份资料？先做 30 秒资料诊断。</p>
        <a class="lead-survey-cta" href="/survey/">做资料诊断 →</a>
      </div>

      <div class="lead-divider">已经确定要领取这份资料？使用下方方式：</div>

      <div class="lead-actions">
        <a class="lead-primary" href={tallyUrl} target="_blank" rel="noopener noreferrer">
          打开领取表单
        </a>
        <a class="lead-secondary" href="/">
          返回网站首页
        </a>
      </div>

      <div class="fallback-box">
        <h2>如果表单打不开怎么办？</h2>
        <p>
          国内网络访问海外表单可能会不稳定。如果 Tally 表单打不开，可以直接添加微信领取资料。
        </p>

        <div class="wechat-row">
          <span>备用微信号</span>
          <strong id="wechat-value">{backupWechat}</strong>
          <button id="copy-wechat" type="button">复制微信号</button>
        </div>

        <p class="hint">
          添加时备注：<strong id="wechat-note">{pack.note}</strong>，我会按顺序发送资料。
        </p>
      </div>

      <div class="resource-list">
        {pack.items.map((item) => (
          <div>✓ {item}</div>
        ))}
      </div>
    </section>
  </main>

  <script>
    const button = document.querySelector("#copy-wechat");
    const value = document.querySelector("#wechat-value");

    if (button && value) {
      button.addEventListener("click", async () => {
        const text = value.textContent || "";
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "已复制";
          setTimeout(() => {
            button.textContent = "复制微信号";
          }, 1600);
        } catch (error) {
          button.textContent = "请手动复制";
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .lead-page {
    min-height: 100vh;
    padding: 64px 24px 84px;
    background:
      radial-gradient(circle at 24% 12%, rgba(19, 104, 255, 0.10), transparent 26%),
      linear-gradient(180deg, #f6f9fd 0%, #eef3fa 100%);
  }

  .lead-card {
    max-width: 880px;
    margin: 0 auto;
    padding: 44px;
    border-radius: 30px;
    background:
      radial-gradient(circle at 90% 0%, rgba(19, 104, 255, 0.08), transparent 28%),
      rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(226, 232, 240, 0.96);
    box-shadow:
      0 24px 80px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255,255,255,0.95);
  }

  .lead-kicker {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    background: #eef5ff;
    color: #1368ff;
    border: 1px solid #dceaff;
    font-size: 13px;
    font-weight: 900;
    margin-bottom: 16px;
  }

  .lead-card h1 {
    margin: 0;
    color: #0f172a;
    font-size: 44px;
    line-height: 1.16;
    letter-spacing: -1px;
  }

  .lead-desc {
    max-width: 680px;
    margin: 16px 0 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .lead-survey-hint {
    margin-top: 24px;
    padding: 16px 20px;
    border-radius: 14px;
    background: #f0f7ff;
    border: 1px solid #dceaff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .lead-survey-hint p {
    margin: 0;
    color: #1e3a5f;
    font-size: 15px;
    font-weight: 700;
  }

  .lead-survey-cta {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    border-radius: 10px;
    background: #1368ff;
    color: #fff;
    font-weight: 900;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .lead-survey-cta:hover {
    background: #0f5ae0;
  }

  .lead-divider {
    margin-top: 28px;
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 0;
  }

  .lead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 12px;
  }

  .lead-primary,
  .lead-secondary {
    height: 48px;
    padding: 0 22px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
  }

  .lead-primary {
    background: #1368ff;
    color: #fff;
    box-shadow: 0 14px 34px rgba(19, 104, 255, 0.22);
  }

  .lead-secondary {
    background: #f3f7ff;
    color: #1368ff;
    border: 1px solid #d8e7ff;
  }

  .fallback-box {
    margin-top: 30px;
    padding: 24px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 90% 0%, rgba(19, 104, 255, 0.10), transparent 30%),
      #f8fbff;
    border: 1px solid #dceaff;
  }

  .fallback-box h2 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 24px;
    line-height: 1.35;
  }

  .fallback-box p {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  .wechat-row {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 96px 1fr 128px;
    gap: 12px;
    align-items: center;
    padding: 14px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
  }

  .wechat-row span {
    color: #64748b;
    font-size: 14px;
  }

  .wechat-row strong {
    color: #0f172a;
    font-size: 18px;
    word-break: break-all;
  }

  .wechat-row button {
    height: 40px;
    border: 0;
    border-radius: 11px;
    background: #0f172a;
    color: #fff;
    font-weight: 900;
    cursor: pointer;
  }

  .hint {
    margin-top: 14px !important;
  }

  .resource-list {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .resource-list div {
    padding: 14px 16px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #e6eaf2;
    color: #334155;
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .lead-page {
      padding: 34px 14px 56px;
    }

    .lead-card {
      padding: 26px;
      border-radius: 24px;
    }

    .lead-card h1 {
      font-size: 34px;
    }

    .wechat-row {
      grid-template-columns: 1fr;
    }

    .resource-list {
      grid-template-columns: 1fr;
    }
  }
</style>
