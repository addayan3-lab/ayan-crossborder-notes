---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { hookTypeLabels } from "../../lib/knowledge-map";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft))
  .filter((p) => p.data.articleType === "case-study" || p.data.hookType)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const hookTypes = hookTypeLabels.filter((t) => t !== "全部");
---

<BaseLayout title="亚马逊运营实操案例库｜阿岩跨境笔记" description="用脱敏案例拆解亚马逊选品、Listing、PPC、Review 和新品冷启动问题，帮助新手把 AI 提示词、资料表格和运营动作串起来。">
  <section class="page-hero">
    <div class="page-hero-inner">
      <h1>亚马逊运营实操案例库</h1>
      <p>每个案例都来自真实运营场景，已做脱敏处理。按类型筛选，对照自己的情况看清分析路径。</p>
      <div class="hero-actions">
        <a class="cta-primary" href="#cases">浏览全部案例 →</a>
        <a class="cta-secondary" href="/survey/">做 30 秒资料诊断</a>
      </div>
    </div>
  </section>

  <section class="section" id="cases">
    <div class="filter-bar" role="tablist" aria-label="案例类型筛选">
      <button type="button" class="filter-btn active" data-filter="全部">全部</button>
      {hookTypes.map((type) => (
        <button type="button" class="filter-btn" data-filter={type}>{type}</button>
      ))}
    </div>

    <div class="grid grid-3" id="case-grid">
      {allPosts.map((post) => (
        <a
          class="card case-card"
          href={`/articles/${post.id}/`}
          data-hook-type={post.data.hookType || "案例复盘"}
        >
          {post.data.hookType && <span class="tag tag-hook">{post.data.hookType}</span>}
          <span class="tag">{post.data.category}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>

    <div class="topic-intro cta-soft">
      <h2>不确定自己的情况属于哪一类？</h2>
      <p>可以先做 30 秒资料诊断，或者直接问 AI 阿岩助手。</p>
      <div class="cta-soft-actions">
        <a class="cta-primary" href="/survey/">做 30 秒资料诊断</a>
        <a class="cta-secondary" href="/ask/">问问 AI 阿岩助手</a>
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".case-card");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") || "全部";
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        cards.forEach((card) => {
          const type = card.getAttribute("data-hook-type") || "";
          const show = filter === "全部" || type === filter;
          card.style.display = show ? "" : "none";
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 14px;
    text-decoration: none;
  }

  .cta-primary {
    background: #1368ff;
    color: #fff;
  }

  .cta-secondary {
    background: #fff;
    color: #1368ff;
    border: 1px solid #dce2ec;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .filter-btn {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .filter-btn.active {
    background: #1368ff;
    border-color: #1368ff;
    color: #fff;
  }

  .grid {
    display: grid;
    gap: 16px;
    margin-bottom: 28px;
  }

  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #eef1f6;
    text-decoration: none;
    color: inherit;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
  }

  .tag {
    display: inline-block;
    width: fit-content;
    padding: 4px 10px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .tag-hook {
    background: #eef5ff;
    color: #1368ff;
  }

  .card h3 {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #0f172a;
  }

  .card p {
    margin: 0;
    font-size: 13px;
    color: #64748b;
    line-height: 1.7;
  }

  .topic-intro {
    max-width: 880px;
    padding: 24px 28px;
    border-radius: 20px;
    background: linear-gradient(135deg, #f0f7ff 0%, #eef5ff 100%);
    border: 1px solid #cfe0ff;
  }

  .topic-intro h2 {
    margin: 0 0 10px;
    font-size: 22px;
  }

  .topic-intro p {
    margin: 0 0 16px;
    color: #475569;
  }

  .cta-soft-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
